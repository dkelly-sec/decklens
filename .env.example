# Copy this file to .env and fill in real values. .env is gitignored; never commit it.

# From https://developer.clashroyale.com -> My Account -> Create New Key.
# The key only works from the IP address(es) you whitelist when creating it.
CR_API_TOKEN=replace-me

# Local Postgres (matches docker-compose.yml). Use a long random password.
POSTGRES_USER=decklens
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=decklens
DATABASE_URL=postgresql://decklens:replace-me@127.0.0.1:5432/decklens

# Read-only login for the web app's player search (create it with db/web_role.sql).
WEB_DATABASE_URL=postgresql://decklens_web:replace-me@127.0.0.1:5432/decklens

# Signs login cookies. A long random value; changing it logs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DECKLENS_SECRET_KEY=replace-me

# Logins are on by default. "off" only works locally (never with DECKLENS_HTTPS=1).
# DECKLENS_LOGIN=off

# Owner login for the account tool (python -m decklens.users) if DATABASE_URL isn't the owner.
# ADMIN_DATABASE_URL=postgresql://decklens:replace-me@127.0.0.1:5432/decklens
